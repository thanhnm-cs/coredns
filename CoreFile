https://.:8553 {
    forward . /etc/resolv.conf
    log
    errors
    health {
        lameduck 5s
    }
    cache 120
    loop
    loadbalance
    ready
    prometheus 0.0.0.0:8080
}
https://.com.:8553 {
    acl forwhimsicottan.com {
        drop net 0.0.0.0/0
    }
    forward . /etc/resolv.conf
    log
    errors
    health {
        lameduck 5s
    }
    cache 120
    loop
    loadbalance
    ready
    prometheus 0.0.0.0:8080
}

