https://.:8553 {

    acl facebook.com {
        block net 0.0.0.0/0
    }
    acl vnexpress.net {
        block net 0.0.0.0/0
    }

    forward . /etc/resolv.conf
    log
    errors
    health {
        lameduck 5s
    }
    cache 120
    loop
    loadbalance
    ready
    prometheus 0.0.0.0:8080
}